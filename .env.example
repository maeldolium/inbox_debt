# ============================================================================
# Configuration de l'application Inbox Debt
# ============================================================================
# IMPORTANT: Copier ce fichier en .env et remplir les valeurs réelles
# Ne JAMAIS committer .env ! (fichier ignoré par git)
# ============================================================================

# ============================================================================
# SÉCURITÉ - Clé de chiffrement Flask (Flask Session & CSRF)
# ============================================================================
# Générer une clé :
#   python -c "import secrets; print(secrets.token_hex(32))"
# Résultat exemple: a7f3b2c9d8e4f1a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8
FLASK_SECRET_KEY=your-secret-key-here-generate-one

# ============================================================================
# ENVIRONNEMENT
# ============================================================================
# Options: development | staging | production
FLASK_ENV=development

# ============================================================================
# MODE APPLICATION
# ============================================================================
# Options: local | demo
# - local: utilise l'authentification Gmail réelle (nécessite oauth)
# - demo: utilise des données fictives depuis mock_analysis.json (pas d'auth)
APP_MODE=demo

# ============================================================================
# DEBUG (optionnel, détecté automatiquement selon FLASK_ENV)
# ============================================================================
# DEBUG=True
